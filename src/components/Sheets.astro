---
import ContactCard from "./ContactCard.astro";
import { copy } from "../i18n/copy";
import { pathFor, type Lang, type PageId } from "../i18n/site";

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = copy[lang];
const languages = [
  { code: "de" as const, label: "Deutsch" },
  { code: "en" as const, label: "English" },
  { code: "bs" as const, label: "Bosanski" },
];
---

<div class="sheet" id="language-sheet" hidden>
  <div class="sheet-card" role="dialog" aria-modal="true" aria-label={t.language} tabindex="-1">
    {
      languages.map((item) => (
        <a
          class="sheet-link"
          href={pathFor(item.code, page)}
          hreflang={item.code}
          lang={item.code}
          aria-current={item.code === lang ? "page" : undefined}
        >
          <span class="sheet-icon lang-mark">{item.code}</span>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</div>

<div class="sheet" id="connect-sheet" hidden>
  <div class="sheet-card connect-card" role="dialog" aria-modal="true" aria-label={t.nav.contact} tabindex="-1">
    <ContactCard lang={lang} />
  </div>
</div>

<div class="sheet" id="cv-sheet" hidden>
  <div class="sheet-card cv-card" role="dialog" aria-modal="true" aria-label={t.cv.eyebrow} tabindex="-1">
    <button class="cv-close" type="button" data-close-sheet>{t.closeMenu}</button>
    <picture>
      <source srcset="/portrait.avif" type="image/avif" />
      <source srcset="/portrait.webp" type="image/webp" />
      <img
        class="cv-photo"
        src="/portrait.png"
        width="1280"
        height="720"
        alt={t.cv.portraitAlt}
        decoding="async"
      />
    </picture>
    <div class="cv-body">
      <p class="cv-name">Ahmedin Fajic</p>
      <ol class="cv-line">
        {
          t.cv.entries.map((entry) => (
            <li>
              <span class="cv-years">{entry.years}</span>
              <span class="cv-place">{entry.place}</span>
              <span class="cv-note">{entry.note}</span>
            </li>
          ))
        }
      </ol>
      <div class="cv-foot">
        {
          t.cv.facts.map((fact) => (
            <p>
              <span>{fact.label}</span>
              {fact.text}
              {fact.years && <> {fact.years}</>}
            </p>
          ))
        }
        <p>
          <span>{t.cv.languagesTitle}</span>
          {t.cv.languagesText}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const panel = document.querySelector(".menu-panel");
  const sheets = {
    language: document.getElementById("language-sheet"),
    connect: document.getElementById("connect-sheet"),
    cv: document.getElementById("cv-sheet"),
  };
  let returnFocus: HTMLElement | null = null;

  function menuOpen() {
    return panel instanceof HTMLElement && !panel.hidden;
  }

  function sheetOpen() {
    return Object.values(sheets).some((sheet) => sheet instanceof HTMLElement && !sheet.hidden);
  }

  function lockPage() {
    document.body.style.overflow = menuOpen() || sheetOpen() ? "hidden" : "";
  }

  function hideSheets() {
    for (const sheet of Object.values(sheets)) {
      if (sheet instanceof HTMLElement) sheet.hidden = true;
    }
  }

  function setMenu(open: boolean) {
    if (!(panel instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
    panel.hidden = !open;
    panel.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? toggle.dataset.labelClose ?? "" : toggle.dataset.labelOpen ?? "");
    const word = toggle.querySelector(".menu-toggle-word");
    const mark = toggle.querySelector(".menu-toggle-mark");
    word?.classList.toggle("is-in", !open);
    word?.classList.toggle("is-out", open);
    mark?.classList.toggle("is-in", open);
    mark?.classList.toggle("is-out", !open);
    lockPage();
  }

  function openSheet(sheet: HTMLElement, trigger: HTMLElement) {
    setMenu(false);
    hideSheets();
    returnFocus = trigger;
    sheet.hidden = false;
    lockPage();
    const dialog = sheet.querySelector("[role='dialog']");
    if (dialog instanceof HTMLElement) dialog.focus();
  }

  function closeSheets() {
    hideSheets();
    lockPage();
    returnFocus?.focus();
    returnFocus = null;
  }

  toggle?.addEventListener("click", () => {
    setMenu(!menuOpen());
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.querySelectorAll("[data-open]").forEach((control) => {
    control.addEventListener("click", () => {
      if (!(control instanceof HTMLElement)) return;
      const name = control.dataset.open;
      const sheet = name ? sheets[name as keyof typeof sheets] : undefined;
      if (sheet instanceof HTMLElement) openSheet(sheet, control);
    });
  });

  document.querySelectorAll("[data-close-sheet]").forEach((control) => {
    control.addEventListener("click", () => closeSheets());
  });

  document.querySelectorAll(".sheet").forEach((sheet) => {
    sheet.addEventListener("click", (event) => {
      if (event.target === sheet) closeSheets();
    });
  });

  window.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (sheetOpen()) closeSheets();
    else if (menuOpen()) setMenu(false);
  });

  window.matchMedia("(min-width: 801px)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });
</script>
