---
import Base from "../layouts/Base.astro";
import { copy } from "../i18n/copy";
import { linkedinUrl, type Lang } from "../i18n/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];

// Projekte und Referenzen: src/components/Projects.astro und Testimonials.astro
// zwischen Über und Kontakt einbinden, sobald echte Einträge vorliegen.
// TODO: GitHub-Link neben LinkedIn ergänzen, sobald die URL feststeht.
---

<Base lang={lang} page="home" title={t.meta.home.title} description={t.meta.home.description}>
  <section class="hero">
    <div class="hero-inner">
      <h1>{t.hero.title}</h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-actions">
        <button class="button" type="button" data-open="connect">{t.hero.primary}</button>
        <a class="text-link" href="#leistungen">{t.hero.secondary}</a>
      </div>
      <div class="trust">
        <p class="trust-stat">
          <span class="trust-years">{t.trustYears}</span>
          <span class="trust-years-label">{t.trustYearsLabel}</span>
        </p>
        <span class="trust-rule" aria-hidden="true"></span>
        <p class="trust-copy">
          {t.trustBefore}<span class="trust-name">{t.trustNameA}</span>{t.trustMid}<span class="trust-name">{t.trustNameB}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="leistungen">
    <div class="wrap">
      <h2>{t.servicesTitle}</h2>
      <ul class="cards">
        {
          t.services.map((item) => (
            <li class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="measure">
        <h2>{t.situationTitle}</h2>
        <p>{t.situation}</p>
      </div>
    </div>
  </section>

  <section class="section" id="vorgehensweise">
    <div class="wrap">
      <h2>{t.approachTitle}</h2>
      <ol class="steps">
        {
          t.steps.map((step, index) => (
            <li>
              <span class="step-index" aria-hidden="true">
                {index + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="ueber">
    <div class="wrap">
      <div class="measure">
        <h2>{t.aboutTitle}</h2>
        <div class="about-intro">
          <picture>
            <source srcset="/portrait.avif" type="image/avif" />
            <source srcset="/portrait.webp" type="image/webp" />
            <img
              class="about-portrait"
              src="/portrait.png"
              width="108"
              height="108"
              alt={t.aboutPortraitAlt}
              decoding="async"
            />
          </picture>
          <p>{t.about}</p>
        </div>
        <ul class="inline-links">
          <li><button class="button" type="button" data-open="cv">{t.aboutCv}</button></li>
          <li>
            <a class="text-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer">
              LinkedIn
              <span class="sr-only"> ({t.newTab})</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="closing" id="kontakt">
    <h2>{t.contactTitle}</h2>
    <!-- TODO: Kalenderlink (meetingHref) einsetzen, sobald ein Terminlink feststeht. -->
    <button class="button" type="button" data-open="connect">{t.contactButton}</button>
    <p class="closing-note">{t.contactNote}</p>
  </section>
</Base>
