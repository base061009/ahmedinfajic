---
import { copy } from "../i18n/copy";
import {
  email,
  emailHref,
  linkedinUrl,
  phoneDisplay,
  phoneHref,
  type Lang,
} from "../i18n/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<div class="sheet-actions">
  <a class="sheet-link" href={emailHref}>
    <span class="sheet-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <rect x="3.2" y="5.2" width="17.6" height="13.6" rx="2.2"></rect>
        <path d="M4 6.4 12 13l8-6.6"></path>
      </svg>
    </span>
    <span>{t.mail}</span>
  </a>
  <a class="sheet-link sheet-phone-mobile" href={phoneHref}>
    <span class="sheet-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path
          d="M8.2 4.8h2.1l1.1 3.2-1.4 1a11.2 11.2 0 0 0 4.9 4.9l1-1.4 3.2 1.1v2.1a1.7 1.7 0 0 1-1.8 1.8A13.8 13.8 0 0 1 4.5 6.6 1.7 1.7 0 0 1 6.3 4.8Z"
        ></path>
      </svg>
    </span>
    <span>{t.phone}</span>
  </a>
  <a class="sheet-link sheet-phone-desktop" href={phoneHref}>
    <span class="sheet-qr">
      <img src="/phone-qr.svg" width="58" height="58" alt="" />
    </span>
    <span>{t.phoneScan}</span>
  </a>
  <a class="sheet-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer">
    <span class="sheet-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="3.2"></rect>
        <path d="M8.2 10.4v6.4M8.2 7.55v.08"></path>
        <path d="M12.05 16.8v-3.7c0-1.15.9-2.05 2.05-2.05s2.05.9 2.05 2.05v3.7"></path>
      </svg>
    </span>
    <span>
      LinkedIn
      <span class="sr-only"> ({t.newTab})</span>
    </span>
  </a>
</div>
<div class="sheet-details">
  <p>
    <span>{t.phone}</span>
    <a href={phoneHref}>{phoneDisplay}</a>
  </p>
  <p>
    <span>{t.mail}</span>
    <a href={emailHref}>{email}</a>
  </p>
</div>
