---
/**
 * Vorbereitet, noch nicht eingebunden.
 * Echte Referenzen hier eintragen und in der Startseite aktivieren.
 * Keine Platzhalter veröffentlichen. informatically.com nicht wieder aufnehmen.
 *
 * Einbindung in src/pages/[lang]/index.astro:
 *   import Projects from "../../components/Projects.astro";
 *   <Projects lang={lang} />
 * Danach den Navigationspunkt ergänzen.
 */
import type { Lang } from "../i18n/site";

interface Props {
  lang: Lang;
}

interface Project {
  name: string;
  href: string;
  summary: string;
}

const { lang } = Astro.props;

const text = {
  de: {
    title: "Projekte",
    intro: "Ausgewählte Arbeiten für Unternehmen und Organisationen.",
  },
  en: {
    title: "Projects",
    intro: "Selected work for companies and organisations.",
  },
  bs: {
    title: "Projekti",
    intro: "Odabrani radovi za preduzeća i organizacije.",
  },
}[lang];

const projects: Project[] = [
  // { name: "", href: "https://", summary: "" },
];
---

{
  projects.length > 0 && (
    <section class="section" id="projekte" aria-labelledby="projekte-title">
      <div class="wrap">
        <h2 id="projekte-title">{text.title}</h2>
        <p class="measure">{text.intro}</p>
        <ul class="ref-list">
          {projects.map((project) => (
            <li>
              <a href={project.href} target="_blank" rel="noopener noreferrer">
                {project.name}
              </a>
              <p>{project.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .ref-list {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .ref-list li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .ref-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text);
    text-decoration: none;
  }

  .ref-list a:hover {
    color: var(--accent);
  }

  .measure {
    color: var(--muted);
  }
</style>
