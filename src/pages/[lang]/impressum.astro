---
import Base from "../../layouts/Base.astro";
import { copy } from "../../i18n/copy";
import { email, emailHref, isLang, langs } from "../../i18n/site";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
if (!isLang(lang)) {
  throw new Error("Unknown language");
}

const t = copy[lang];
---

<Base
  lang={lang}
  page="impressum"
  title={t.meta.impressum.title}
  description={t.meta.impressum.description}
>
  <section class="section legal">
    <div class="wrap">
      <div class="measure">
        <h1>{t.imprint}</h1>
        <dl class="facts">
          <div>
            <dt>{t.imp.name}</dt>
            <dd>Ahmedin Fajić</dd>
          </div>
          <div>
            <dt>{t.imp.address}</dt>
            <dd>{t.imp.addressText}</dd>
          </div>
          <div>
            <dt>{t.imp.email}</dt>
            <dd><a href={emailHref}>{email}</a></dd>
          </div>
          <div>
            <dt>{t.imp.purpose}</dt>
            <dd>{t.imp.purposeText}</dd>
          </div>
          <div>
            <dt>{t.imp.authority}</dt>
            <dd>{t.imp.authorityText}</dd>
          </div>
          <div>
            <dt>{t.imp.law}</dt>
            <dd>
              {t.imp.lawText}{" "}
              <a href="https://www.ris.bka.gv.at" target="_blank" rel="noopener noreferrer">
                www.ris.bka.gv.at
                <span class="sr-only"> ({t.newTab})</span>
              </a>
            </dd>
          </div>
          <div>
            <dt>{t.imp.member}</dt>
            <dd>{t.imp.memberText}</dd>
          </div>
          <div>
            <dt>{t.imp.gisa}</dt>
            <dd>{t.imp.gisaText}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>
