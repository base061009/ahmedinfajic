---
import "@fontsource/cardo/latin-400.css";
import "@fontsource/cardo/latin-ext-400.css";
import cardoLatin from "@fontsource/cardo/files/cardo-latin-400-normal.woff2";
import cardoLatinExt from "@fontsource/cardo/files/cardo-latin-ext-400-normal.woff2";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sheets from "../components/Sheets.astro";
import { copy } from "../i18n/copy";
import { jsonLd } from "../i18n/schema";
import { absoluteUrl, langs, ogLocales, site, type Lang, type PageId } from "../i18n/site";

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { lang, page, title, description, noindex = false } = Astro.props;
const t = copy[lang];
const canonical = absoluteUrl(lang, page);
const image = Astro.props.image ?? `${site}/og-${lang}.jpg`;
const imageAlt = Astro.props.imageAlt ?? t.ogAlt;
const json = jsonLd(lang, page);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={cardoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cardoLatinExt} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <meta name="theme-color" content="#fffefc" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {langs.map((code) => (
            <link rel="alternate" hreflang={code} href={absoluteUrl(code, page)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absoluteUrl("de", page)} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={t.name} />
          <meta property="og:locale" content={ogLocales[lang]} />
          {langs
            .filter((code) => code !== lang)
            .map((code) => (
              <meta property="og:locale:alternate" content={ogLocales[code]} />
            ))}
          <meta property="og:url" content={canonical} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={image} />
          <meta property="og:image:secure_url" content={image} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={imageAlt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={image} />
          <meta name="twitter:image:alt" content={imageAlt} />
          <script type="application/ld+json" is:inline set:html={json} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#inhalt">{t.skip}</a>
    <Header lang={lang} page={page} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <Sheets lang={lang} page={page} />
  </body>
</html>
